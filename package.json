{
  "name": "@wave-rf/astro-trademarks",
  "version": "0.1.1",
  "description": "Astro integration that marks the first mention of each third-party trademark on a page with ® or ™ and renders that page's trademark notices — for .astro, Markdown, MDX and Starlight pages alike.",
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "withastro",
    "starlight",
    "trademark",
    "trademarks",
    "legal",
    "attribution"
  ],
  "license": "MIT",
  "author": {
    "name": "Wave RF",
    "url": "https://wave-rf.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wave-RF/astro-trademarks.git"
  },
  "bugs": {
    "url": "https://github.com/Wave-RF/astro-trademarks/issues"
  },
  "homepage": "https://github.com/Wave-RF/astro-trademarks#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "default": "./dist/html.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./TrademarkNotices.astro": "./components/TrademarkNotices.astro",
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "components",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:fixtures": "node scripts/test-fixtures.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "verify": "biome check . && pnpm run typecheck && pnpm test && bash scripts/ci-marker.sh write",
    "setup": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "entities": "^8.0.0",
    "parse5": "^8.0.0"
  },
  "peerDependencies": {
    "astro": ">=6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^24.0.0",
    "astro": "^7.3.5",
    "typescript": "^6.0.3"
  }
}
